# CURVA — Variabili d'ambiente
# Copia questo file in .env e compila le chiavi reali.
# Le variabili EXPO_PUBLIC_* sono accessibili nel bundle JS (non mettere segreti server).

# --- GraphHopper (routing motolistico curvy) ---
# Registrati su https://www.graphhopper.com/ → API Key gratuita 500 req/day
EXPO_PUBLIC_GRAPHHOPPER_API_KEY=la_tua_chiave_graphhopper

# --- MapTiler (mappe e geocoding) ---
# Registrati su https://www.maptiler.com/ → API Key gratuita 100k tile/mese
EXPO_PUBLIC_MAPTILER_API_KEY=la_tua_chiave_maptiler

# --- Supabase (database community ratings) ---
# Registrati su https://supabase.com/ → crea progetto → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=la_tua_anon_key_supabase
