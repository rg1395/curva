# GraphHopper Routing API
# Get a free key at https://www.graphhopper.com/
# Free tier: 500 requests/day
EXPO_PUBLIC_GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# MapTiler (for map tiles and geocoding)
# Get a free key at https://cloud.maptiler.com/
# Free tier: ~100k tile requests/month
EXPO_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# Supabase (PostgreSQL + Auth + Edge Functions)
# Get these from your Supabase project settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
